{
  "name": "@yathomasi/cypress-parallel",
  "version": "3.0.0",
  "author": "Thomas Kunwar",
  "license": "MIT",
  "homepage": "https://github.com/yathomasi/cypress-parallel",
  "repository": {
    "type": "git",
    "url": "https://github.com/yathomasi/cypress-parallel.git"
  },
  "keywords": [
    "cypress",
    "cypress-parallel"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "knapsack-reporter.js",
    "knapsack-reporter.d.ts"
  ],
  "bin": {
    "cypress-parallel": "bin/cypress-parallel"
  },
  "scripts": {
    "clean": "rm -f knapsack-reporter.{js,d.ts} && bash -O globstar -c 'rm -f lib/**/*.{js,d.ts}'",
    "build": "tsc",
    "watch": "tsc --watch",
    "fmt": "prettier --ignore-path .gitignore --write '**/*.ts'",
    "test": "npm run test:fmt && npm run test:integration",
    "test:fmt": "prettier --ignore-path .gitignore --check '**/*.ts'",
    "test:integration": "cucumber-js",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@badeball/cypress-configuration": "^6.1.1",
    "commander": "^14.0.3",
    "cosmiconfig": "^9.0.2",
    "cypress-multi-reporters": "^2.0.5",
    "debug": "^4.4.3",
    "is-npm": "^5.0.0",
    "shell-quote": "^1.8.3"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.4",
    "@babel/types": "^7.28.4",
    "@cucumber/cucumber": "^8.0.0",
    "@cucumber/pretty-formatter": "^1.0.0-alpha.1",
    "@types/debug": "^4.1.7",
    "@types/mocha": "^9.1.0",
    "@types/prettier": "^2.7.3",
    "@types/shell-quote": "^1.7.1",
    "@types/stream-buffers": "^3.0.4",
    "ast-types": "^0.16.1",
    "cypress": "^10.0.0 || ^11.0.0 || ^12.0.0 || ^13.0.0 || ^14.0.0 || ^15.0.0 || ^16.0.0",
    "mocha": "^8.2.0",
    "prettier": "^2.8.8",
    "recast": "^0.23.11",
    "stream-buffers": "^3.0.2",
    "strip-indent": "^3.0.0",
    "ts-node": "^10.2.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "cypress": "^10.0.0 || ^11.0.0 || ^12.0.0 || ^13.0.0 || ^14.0.0 || ^15.0.0 || ^16.0.0",
    "mocha": ">=6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
